#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        // Юникод макросы для Linux (Ctrl+Shift+U + HEX + Space)
        u_excl:  u_excl  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp N1 &kp SPACE>; }; // !
        u_ques:  u_ques  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N3 &kp F &kp SPACE>; }; // ?
        u_quot:  u_quot  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp N2 &kp SPACE>; }; // "
        u_apos:  u_apos  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp N7 &kp SPACE>; }; // '
        u_tilde: u_tilde { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N7 &kp E &kp SPACE>; }; // ~
        u_grave: u_grave { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N6 &kp N0 &kp SPACE>; }; // `
        u_semi:  u_semi  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N3 &kp B &kp SPACE>; }; // ;
        u_colon: u_colon { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N3 &kp A &kp SPACE>; }; // :
        u_amp:   u_amp   { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp N6 &kp SPACE>; }; // &
        u_dollar: u_dollar { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp N4 &kp SPACE>; }; // $
        u_comma: u_comma { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp C &kp SPACE>; }; // ,
        u_dot:   u_dot   { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp E &kp SPACE>; }; // .
        u_perc:  u_perc  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp N5 &kp SPACE>; }; // %
        u_star:  u_star  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp A &kp SPACE>; }; // *
        u_slash: u_slash { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp F &kp SPACE>; }; // /
        u_pipe:  u_pipe  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N7 &kp C &kp SPACE>; }; // |
        u_lpar:  u_lpar  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp N8 &kp SPACE>; }; // (
        u_rpar:  u_rpar  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N2 &kp N9 &kp SPACE>; }; // )
        u_lbrace: u_lbrace { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N7 &kp B &kp SPACE>; }; // {
        u_rbrace: u_rbrace { compatible = "zmk,behavior-macro"; #binding-cells = <0>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp LC(LS(U)) &kp N7 &kp D &kp SPACE>; }; // }
    };

    behaviors {
        my_mt: custom_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // Пары для 2-го ряда
        ex_qu: ex_qu { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "tap-preferred"; tapping-term-ms = <200>; bindings = <&u_ques>, <&u_excl>; };
        qu_ap: qu_ap { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "tap-preferred"; tapping-term-ms = <200>; bindings = <&u_apos>, <&u_quot>; };
        ti_gr: ti_gr { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "tap-preferred"; tapping-term-ms = <200>; bindings = <&u_grave>, <&u_tilde>; };
        se_co: se_co { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "tap-preferred"; tapping-term-ms = <200>; bindings = <&u_colon>, <&u_semi>; };
        am_ca: am_ca { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "tap-preferred"; tapping-term-ms = <200>; bindings = <&u_dollar>, <&u_amp>; };

        // Пары для 3-го ряда
        co_do: co_do { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "tap-preferred"; tapping-term-ms = <200>; bindings = <&u_dot>, <&u_comma>; };
        pe_st: pe_st { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "tap-preferred"; tapping-term-ms = <200>; bindings = <&u_star>, <&u_perc>; };
        sl_pi: sl_pi { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "tap-preferred"; tapping-term-ms = <200>; bindings = <&u_pipe>, <&u_slash>; };
        lp_rp: lp_rp { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "tap-preferred"; tapping-term-ms = <200>; bindings = <&u_rpar>, <&u_lpar>; };
        lb_rb: lb_rb { compatible = "zmk,behavior-hold-tap"; #binding-cells = <2>; flavor = "tap-preferred"; tapping-term-ms = <200>; bindings = <&u_rbrace>, <&u_lbrace>; };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q   &kp W   &kp E   &kp R   &kp T           &kp Y   &kp U   &kp I       &kp O   &my_mt LBKT P
&kp A   &kp S   &kp D   &kp F   &kp G           &kp H   &kp J   &kp K       &kp L   &my_mt SQT SEMI
&my_m RALT Z   &kp X   &kp C   &kp V   &kp B    &kp N   &kp M   &my_mt LGUI COMMA  &my_mt LSHIFT DOT &my_mt LCTRL SLASH
        &my_mt LCTRL CAPS &kp LSHIFT &mo 1      &mo 2   &kp SPACE &kp RALT
            >;
        };

        nav_layer {
            bindings = <
&kp LA(TAB) &kp LC(TAB) &kp LC(LALT) &kp LEFT  &kp RIGHT        &kp ESC  &kp HOME   &kp END     &kp BSPC    &kp DEL
&ex_qu 0 0  &qu_ap 0 0  &ti_gr 0 0   &se_co 0 0 &am_ca 0 0      &kp RET  &kp PG_UP  &kp PG_DN   &kp MINUS   &kp EQUAL
&co_do 0 0  &pe_st 0 0  &sl_pi 0 0   &lp_rp 0 0 &lb_rb 0 0      &kp TAB  &kp PSCRN  &my_mt LGUI GRAVE  &kp LSHIFT  &kp LCTRL
                               &trans    &trans     &trans      &trans   &trans     &trans
            >;
        };

        sym_num_layer {
            bindings = <
&kp N1    &kp N2     &kp N3  &kp N4  &kp N5         &kp N6     &kp N7  &kp N8    &kp N9   &kp N0
&trans    &trans     &trans  &trans  &kp UP         &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans    &trans     &trans  &trans  &kp DOWN       &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                &trans  &trans     &trans           &trans  &kp F11  &kp F12
            >;
        };
    };
};
